<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>69c64f58-e2d0-4adf-8cbd-133366abc833</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.19" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.19" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ContractAI.Services\ContractAI.Services.csproj" />
    <ProjectReference Include="..\ContractAI.Data\ContractAI.Data.csproj" />
  </ItemGroup>

  <!--
    The native clause engine is built out-of-band by CMake (parser/CMakeLists.txt).
    Copy whatever shared library it produced next to the managed assembly so
    P/Invoke resolves "contract_parser" at runtime. Guarded on the directory so a
    checkout that has not built the parser yet still restores and builds; the
    parser is only needed once a contract is actually processed. The Docker build
    (task 6.9) stages the Linux .so the same way.
  -->
  <ItemGroup Condition="Exists('..\..\parser\build')">
    <None Include="..\..\parser\build\libcontract_parser.*"
          CopyToOutputDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

</Project>
